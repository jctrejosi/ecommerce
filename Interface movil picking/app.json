{
  "expo": {
    "name": "DSI Picking",
    "slug": "picking-dsi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pickingapp",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/picking.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0C0D"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "La app usa la cámara para escanear los códigos de barras de los productos durante el alistamiento."
      }
    },
    "android": {
      "package": "com.dsi.pickingapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para escanear los códigos de barras de los productos durante el alistamiento."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F59E0B",
          "defaultChannel": "picking-pending"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para que puedas elegir tu foto de perfil.",
          "cameraPermission": "La app usa la cámara para tomar tu foto de perfil y para escanear los códigos de barras.",
          "microphonePermission": false
        }
      ],
      "expo-audio"
    ]
  }
}
