{
  "expo": {
    "name": "Picking DSI",
    "slug": "picking-dsi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pickingapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "La app usa la cámara para escanear los códigos de barras de los productos durante el alistamiento."
      }
    },
    "android": {
      "package": "com.dsi.pickingapp",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para escanear los códigos de barras de los productos durante el alistamiento."
        }
      ]
    ]
  }
}
