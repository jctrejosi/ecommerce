[Unit]
Description=Auto-despliegue jcti (sondeo de origin/dev)
Documentation=file:///home/deploy/ci-tools/autodeploy.sh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy
Environment=HOME=/home/deploy
# systemd crea /run/jcti con dueño deploy (el usuario no puede escribir en /run).
RuntimeDirectory=jcti
RuntimeDirectoryMode=0755
# -n: si la pasada anterior sigue corriendo, esta se descarta sin encolarse.
ExecStart=/usr/bin/flock -n /run/jcti/autodeploy.lock /home/deploy/ci-tools/autodeploy.sh
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
