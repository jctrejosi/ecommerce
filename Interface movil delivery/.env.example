# Copia este archivo a `.env` y ajusta la URL del backend.
# Solo las variables con prefijo EXPO_PUBLIC_* llegan al bundle de la app.

# ── Dónde vive el backend ─────────────────────────────────────────────
# Producción: mismo origen que la web del cliente (Caddy proxya el API).
EXPO_PUBLIC_API_URL=https://mercaldas.jcti.xyz
# Local (emulador Android con `adb reverse tcp:3000 tcp:3000`):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Local (celular en la misma Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.X.X:3000

# ── Modo mock ─────────────────────────────────────────────────────────
# Sin API_URL (o con esto en true) la app corre con datos de demostración.
EXPO_PUBLIC_USE_MOCK=false
