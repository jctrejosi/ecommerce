{
  "expo": {
    "name": "Delivery DSI",
    "slug": "delivery-dsi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "deliveryapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "La app usa tu ubicación para mostrar tu posición y registrar la entrega del pedido.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "La app usa tu ubicación en segundo plano para actualizar el avance del pedido (fase 2)."
      }
    },
    "android": {
      "package": "com.dsi.deliveryapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para mostrar tu posición y registrar la entrega del pedido.",
          "locationAlwaysAndWhenInUsePermission": "La app usa tu ubicación en segundo plano para actualizar el avance del pedido.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "delivery"
        }
      ]
    ]
  }
}
