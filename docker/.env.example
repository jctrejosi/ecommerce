# ============================================================
# Variables del proyecto compose `ecommerce` (un contenedor por servicio).
# Copia este archivo a `docker/.env` y edítalo. `docker/.env` NO se versiona.
# ============================================================

# ── Dominios / hosts (configúralos aquí, sin rebuild) ───────
# Cada interfaz en su subdominio. Deja vacío (o borra) el que no quieras publicar.
# HOST_API sirve el API completo; HOST_WEB además publica el API en su mismo
# origen (/catalog, /orders, /static, /bot…).
HOST_API=ecommerce-api.tudominio.com
HOST_WEB=ecommerce.tudominio.com
HOST_ADMIN=ecommerce-admin.tudominio.com
HOST_PICKING_ADMIN=ecommerce-picking.tudominio.com
HOST_DELIVERY_ADMIN=ecommerce-delivery.tudominio.com

# Esquema público real (el TLS lo termina el edge compartido / Cloudflare).
PUBLIC_SCHEME=https

# URL pública del API que se HORNEA en los fronts al compilar.
VITE_API_URL=https://ecommerce-api.tudominio.com

# Google OAuth (el client ID es público). Sin esto el botón de Google queda
# deshabilitado. El redirect debe estar autorizado en Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=https://ecommerce.tudominio.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ecommerce.tudominio.com
FRONTEND_URL=https://ecommerce.tudominio.com

# ── Puertos publicados en el host ───────────────────────────
# Solo loopback y puerto propio: el edge compartido publica 80/443.
PUBLIC_HTTP_PORT=127.0.0.1:30180
# BD en loopback para scripts/herramientas del host (nunca a internet).
DB_PUBLISH_PORT=5432

# ── Base de datos (PostgreSQL) ──────────────────────────────
# El servicio `db` del compose se llama `db` dentro de la red interna.
DATABASE_URL=postgres://postgres:postgres@db:5432/ecommerce
DB_SSL=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# CORS: déjalo vacío para que se derive de los HOST_* de las interfaces.
CORS_ORIGIN=

# ── Backend (obligatorias en producción) ────────────────────
NODE_ENV=production
JWT_SECRET=cambia-esto
# local = imágenes en el volumen media (mercadas_media:/app/db)
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Analizador de QR externo (opcional)
QR_ANALYZER_URL=

# Pagos (opcionales)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_REDIRECT_URL=https://ecommerce.tudominio.com
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_TEST=true

# Email
RESEND_API_KEY=

# ── Bot (DeepSeek) ──────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
BOT_API_PORT=8001

# ── Basic Auth de los paneles admin y de /bot ──
# PROTECT_ADMIN/PROTECT_BOT ya son true por defecto; el proxy NO arranca
# sin ADMIN_PASSWORD (o ADMIN_PASSWORD_HASH). Cambia esta contraseña.
#ADMIN_USER=admin
#ADMIN_PASSWORD=cambia-esto
#PROTECT_ADMIN=false
#PROTECT_BOT=false

# ── OSRM (rutas de delivery) ──
# El servicio `osrm` del compose; el backend lo resuelve por DNS interno.
OSRM_URL=http://osrm:5000

# ── Hosts heredados (opcional, separados por comas) ─────────
# Sirven lo mismo que los HOST_* de arriba. Permiten migrar el dominio sin
# romper APKs ya instaladas, Google OAuth ni webhooks configurados.
#HOST_API_LEGACY=mercaldas-api.jcti.xyz
#HOST_WEB_LEGACY=mercaldas.jcti.xyz
#HOST_ADMIN_LEGACY=mercaldas-admin.jcti.xyz
#HOST_PICKING_ADMIN_LEGACY=mercaldas-picking.jcti.xyz
#HOST_DELIVERY_ADMIN_LEGACY=mercaldas-delivery.jcti.xyz
