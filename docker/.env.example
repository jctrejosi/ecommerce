# ============================================================
# Variables del contenedor único de Mercaldas.
# Copia este archivo a `docker/.env` y edítalo. `docker/.env` NO se versiona.
# ============================================================

# ── Dominios / hosts (configúralos aquí, sin rebuild) ───────
# Cada interfaz en su subdominio. Deja vacío (o borra) el que no quieras publicar.
HOST_API=api.tudominio.com
HOST_WEB=client.tudominio.com
HOST_ADMIN=admin.tudominio.com
HOST_PICKING_ADMIN=picking-admin.tudominio.com
HOST_DELIVERY_ADMIN=delivery-admin.tudominio.com

# TLS automático (Let's Encrypt vía Caddy). Pon TLS=false si pones un LB/WAF
# delante (Cloudflare, nginx externo) que ya termina el TLS.
TLS=true
ACME_EMAIL=admin@tudominio.com

# URL pública del API que se HORNEA en los fronts al compilar.
# Debe ser https://<HOST_API> (o http:// si TLS=false).
# Recuerda pasarlo también como --build-arg al construir (ver README).
VITE_API_URL=https://api.tudominio.com

# ── Puertos publicados en el host ───────────────────────────
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# ── Base de datos (PostgreSQL) ──────────────────────────────
# BD administrada/remota:
#   DATABASE_URL=postgres://usuario:clave@host:5432/ecommerce
# Contenedor de db/docker adjunto a la red `mercaldas_internal`:
#   DATABASE_URL=postgres://postgres:postgres@ecommerce_postgres:5432/ecommerce
DATABASE_URL=postgres://postgres:postgres@ecommerce_postgres:5432/ecommerce
DB_SSL=false

# CORS: déjalo vacío para que se derive de los HOST_* de las interfaces.
CORS_ORIGIN=

# ── Backend (obligatorias en producción) ────────────────────
NODE_ENV=production
JWT_SECRET=cambia-esto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Analizador de QR externo (opcional)
QR_ANALYZER_URL=

# Pagos (opcionales)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=

# Email
RESEND_API_KEY=

# ── Bot (DeepSeek) ──────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Modo EDGE compartido (recomendado si el servidor tiene más proyectos) ──
# El edge (docker/edge/) publica 80/443 y hace TLS; este contenedor queda en
# loopback con puertos propios. Descomenta estas 6 líneas y reinicia:
#TLS=false
#ALLOW_INSECURE=true
#PUBLIC_SCHEME=https
#PUBLIC_HTTP_PORT=127.0.0.1:30180
#PUBLIC_HTTPS_PORT=127.0.0.1:30181
#TRUST_PROXY=loopback,uniquelocal

# ── Basic Auth de los paneles admin y de /bot ──
# PROTECT_ADMIN/PROTECT_BOT ya son true por defecto; el contenedor NO arranca
# sin ADMIN_PASSWORD (o ADMIN_PASSWORD_HASH). Cambia esta contraseña.
#ADMIN_USER=admin
#ADMIN_PASSWORD=cambia-esto

# ── OSRM (rutas de delivery) ──
# El contenedor de delivery-routing se conecta a la red interna y el backend
# lo alcanza por nombre:  docker network connect mercaldas_internal delivery_osrm
#OSRM_URL=http://delivery_osrm:5000
