# Edge compartido — Caddyfile (se edita a mano, NO lo genera gen-caddyfile.mjs).
#
# ESTADO: servidor nuevo `srv-prod`. Solo está desplegado el ecommerce.
#
# TLS: certificado de ORIGEN de Cloudflare (15 años, CA propia de Cloudflare).
# No se usa ACME/Let's Encrypt: Cloudflare es el único que habla con este
# origen (proxy naranja) y él sí confía en esta CA (modo "Full (strict)").
# El certificado NO es válido para navegadores: si algún registro se pone en
# gris (DNS only), el navegador dará error de certificado.
#
# IMPORTANTE: añade aquí el bloque de cada proyecto SOLO cuando su contenedor
# esté arriba y su DNS apunte ya a este servidor.

{
	email admin@jcti.xyz

	# Cloudflare en modo proxy por delante del origen: recuperar la IP real del
	# cliente desde CF-Connecting-IP para que el rate-limit y los logs no vean
	# IPs de Cloudflare. Rangos de https://api.cloudflare.com/client/v4/ips
	# (fijados el 2026-11-02); se actualizan a mano si Cloudflare publica otros.
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Cabeceras que aporta el edge (TLS/HSTS). El resto (CSP, X-Frame-Options,
# Permissions-Policy…) ya las añade el Caddy interno de cada contenedor.
(edge_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# ── Ecommerce (contenedor `mercaldas_app`, Caddy interno en :8080 sin TLS) ──
# OJO: los hosts deben ser de UN SOLO nivel bajo jcti.xyz. El certificado
# Universal SSL (gratis) de Cloudflare cubre `jcti.xyz` y `*.jcti.xyz`; un
# nombre como `api.mercaldas.jcti.xyz` NO recibe certificado en el borde y el
# handshake TLS falla (alert 40). Para usar dos niveles haría falta Total TLS
# (Advanced Certificate Manager, de pago).
mercaldas.jcti.xyz, mercaldas-api.jcti.xyz, mercaldas-admin.jcti.xyz,
mercaldas-picking.jcti.xyz, mercaldas-delivery.jcti.xyz {
	import edge_headers

	log {
		output stdout
		format json
	}

	# Certificado de origen de Cloudflare (montado en /etc/caddy/edge-tls).
		tls /etc/caddy/edge-tls/origin.pem /etc/caddy/edge-tls/origin.key

		reverse_proxy mercaldas_app:8080
	}

	# ── CRM (contenedor `mercaldas_crm_app`, Caddy interno en :8080 sin TLS) ──
	# El panel y su API viven en el MISMO host: `/api/*` lo sirve el Caddy interno
	# (API_BASE_PATH=/api), así que aquí se reenvía todo sin tocar rutas.
	crm.jcti.xyz {
		import edge_headers

		log {
			output stdout
			format json
		}

		tls /etc/caddy/edge-tls/origin.pem /etc/caddy/edge-tls/origin.key

		reverse_proxy mercaldas_crm_app:8080
	}

	# ── Restaurantes / Punto C (`restaurants_app`, Caddy interno en :8080) ──
	restaurante.jcti.xyz, restaurante-reservas.jcti.xyz, restaurante-cocina.jcti.xyz,
	restaurante-admin.jcti.xyz, restaurante-mesero.jcti.xyz {
		import edge_headers

		log {
			output stdout
			format json
		}

		tls /etc/caddy/edge-tls/origin.pem /etc/caddy/edge-tls/origin.key

		reverse_proxy restaurants_app:8080
	}

	# ── WhatsApp Bot Platform (`whatsapp_bot_web`, nginx en :80) ──
	# nginx sirve el panel y proxya /api y /webhook a `whatsapp_bot_api`.
	bot-platform.jcti.xyz {
		import edge_headers

		log {
			output stdout
			format json
		}

		tls /etc/caddy/edge-tls/origin.pem /etc/caddy/edge-tls/origin.key

		reverse_proxy whatsapp_bot_web:80
	}

	# ── Flauros (monitoreo del servidor, `flauros_web`, nginx en :8080) ──
	# Login propio (usuario y contraseña en el .env del contenedor) y límite de
	# intentos en la API. Se marca `noindex`: es un panel privado, no un sitio.
	flauros.jcti.xyz {
		import edge_headers

		header X-Robots-Tag "noindex, nofollow"

		# El endpoint de salud es para el healthcheck interno del contenedor:
		# no hace falta revelarlo en internet.
		@health path /api/health
		respond @health 404

		log {
			output stdout
			format json
		}

		tls /etc/caddy/edge-tls/origin.pem /etc/caddy/edge-tls/origin.key

		reverse_proxy flauros_web:8080
	}
