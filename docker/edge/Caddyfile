# ── Restaurantes (Punto C) — contenedor `restaurants_app` en shared_edge ──
# El Caddy interno de ese contenedor enruta por Host a cada SPA y /api/* al
# backend NestJS. Aquí solo se termina TLS y se reenvía.
# DNS requerido (tipo A → IP pública): restaurante, restaurante.reservas,
# restaurante.cocina, restaurante.admin y restaurante.mesero (bajo jcti.xyz).
restaurante.jcti.xyz, restaurante.reservas.jcti.xyz,
restaurante.cocina.jcti.xyz, restaurante.admin.jcti.xyz,
restaurante.mesero.jcti.xyz {
	import edge_headers

	log {
		output stdout
		format json
	}

	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			test_dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	# Límite defensivo del cuerpo (el backend ya limita a 10 MB).
	request_body {
		max_size 10MB
	}

	reverse_proxy restaurants_app:8080
}

