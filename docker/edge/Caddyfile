# Edge compartido — Caddyfile (se edita a mano, NO lo genera gen-caddyfile.mjs).
#
# Un bloque por proyecto. Todos los dominios listados deben:
#   1. existir en el DNS (registro A → IP pública del servidor), y
#   2. estar configurados en el proyecto correspondiente (HOST_* en su .env).
# El Host se conserva al reenviar, así que el Caddy interno de cada contenedor
# enruta al vhost correcto.

{
	email admin@jcti.xyz
	# Producción explícita: evita el emisor ZeroSSL por defecto y cualquier
	# intento contra el endpoint de staging (certs no confiables).
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# Cabeceras que aporta el edge (TLS/HSTS). El resto (CSP, X-Frame-Options,
# Permissions-Policy…) ya las añade el Caddy interno de cada contenedor.
(edge_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# ── Ecommerce (contenedor `mercaldas_app`, Caddy interno en :8080 sin TLS) ──
mercaldas.jcti.xyz, api.mercaldas.jcti.xyz, admin.mercaldas.jcti.xyz,
picking-admin.mercaldas.jcti.xyz, delivery-admin.mercaldas.jcti.xyz {
	import edge_headers

	# Log de acceso a stdout (visible con `docker logs edge_caddy`). Permite
	# diagnosticar 4xx/5xx y auditar tráfico. No loguea cuerpos ni credenciales.
	log {
		output stdout
		format json
	}

	# Emisor explícito. Caddy, por defecto, reintenta contra el CA de
	# *staging* (`test_ca`) si el primario falla; eso puede dejar un
	# certificado no confiable. Fijamos ambos al CA de producción.
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			test_dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	reverse_proxy mercaldas_app:8080
}

# ── CRM (contenedor `mercaldas_crm_app`, Caddy interno en :8080 sin TLS) ──
# Descomenta cuando el CRM esté desplegado. Si se deja activo sin el contenedor
# ni DNS, Caddy acumula reintentos de ACME y errores de upstream.
crm.mercaldas.jcti.xyz, crm-api.mercaldas.jcti.xyz {
	import edge_headers

	log {
		output stdout
		format json
	}

	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			test_dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	reverse_proxy mercaldas_crm_app:8080
}


# ── Contabilidad (contenedor `contabdsi_app`, Caddy interno en :8080 sin TLS) ──
#
# Añadir este bloque al Caddyfile del EDGE COMPARTIDO que ya corre en 80/443
# (el de ecommerce: docker/edge/Caddyfile). El edge conserva el Host y reenvía
# a la red `shared_edge`, donde el contenedor de contabilidad escucha en 8080.
#
# Requisitos:
#   1. DNS: contabilidad.jcti.xyz → IP pública del servidor (registro A).
#   2. En docker/.env: HOST_APP=contabilidad.jcti.xyz (mismo host).
#   3. `contabdsi_app` debe estar arriba y unido a `shared_edge`.
#
# Recarga del edge (sin cortar ecommerce/CRM):
#   docker exec edge_caddy caddy reload --config /etc/caddy/Caddyfile
#
# `edge_headers` está definido en el Caddyfile compartido; si pegas este bloque
# en otro archivo, incluye también ese snippet.

contabilidad.jcti.xyz {
	import edge_headers

	log {
		output stdout
		format json
	}

	# Emisor explícito: evita que Caddy reintente contra el CA de staging.
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			test_dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	reverse_proxy contabdsi_app:8080
}

astaroth.jcti.xyz {
	import edge_headers

	log {
		output stdout
		format json
	}

	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			test_dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	# La autenticación la valida el servicio con API_KEYS (X-API-Key o Bearer).
	handle_path /clustering/* {
		reverse_proxy astaroth:8010
	}
	handle_path /xgboost/* {
		reverse_proxy astaroth:8011
	}
	handle_path /uplift/* {
		reverse_proxy astaroth:8012
	}
	handle_path /transformer/* {
		reverse_proxy astaroth:8013
	}
	handle_path /causal/* {
		reverse_proxy astaroth:8014
	}
	handle_path /highs/* {
		reverse_proxy astaroth:8015
	}

	handle {
		respond "Astaroth ML API — /clustering, /xgboost, /uplift, /transformer, /causal, /highs" 200
	}
}

# ── Paimon (audio, imagen y procesamiento) ──
paimon.jcti.xyz {
	import edge_headers

	log {
		output stdout
		format json
	}

	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			test_dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	# La autenticación la valida el servicio con API_KEYS (X-API-Key o Bearer).
	handle_path /audio/* {
		reverse_proxy paimon-audio-processing:8000
	}
	handle_path /image/* {
		reverse_proxy paimon-image-api:8000
	}
	handle_path /processing/* {
		reverse_proxy paimon-image-processing:8000
	}

	handle {
		respond "Paimon — /audio, /image, /processing" 200
	}
}

