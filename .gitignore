/JPG/

# entornos virtuales
/test_db/venv/
__pycache__/

# logs del lanzador
/logs/

# variables de entorno
# No se versiona NINGUN .env real (ni de desarrollo ni de produccion): solo los
# .env.example de referencia, que no llevan credenciales. Cada entorno copia su
# .env.example al archivo que corresponda y lo ajusta a mano:
#   .env  .env.local  .env.development  .env.development.local
#   .env.production  .env.production.local  ...
# Si un .env real quedo en el indice, sacarlo con:
#   git rm --cached <ruta>
.env
.env.*
.env*.local
!.env.example
!**/.env.example
docker/.env
*.env.bak*
.winrm/

# backups de BD (volcados pesados): no versionar, salvo el respaldo canónico
# del ecommerce (db/backups/ecommerce), que sí se versiona troceado para
# restaurar en un clon nuevo con `node dev.js --migrate`.
# OJO: algunos ya estan commiteados; para dejar de seguirlos:
#   git rm -r --cached db/backups
db/backups/*
!db/backups/ecommerce/
!db/backups/ecommerce/**
*.backup

# Archivos físicos crudos de Postgres (heap/_fsm/_vm, no portables a mano).
# Se extraen con las instrucciones de db/pg-raw/README.md; solo se versiona la
# documentación, no los binarios.
db/pg-raw/**
!db/pg-raw/README.md
!db/pg-raw/**/README.md

# Artefactos locales de despliegue (claves, tarballs, scripts ad-hoc)
.scratch/

# Salidas de scripts de análisis (auditorías de dependencias, informes largos)
scripts-agent/out/
