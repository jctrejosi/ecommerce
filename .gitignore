/JPG/

# entornos virtuales
/test_db/venv/
__pycache__/

# logs del lanzador
/logs/

# variables de entorno
.env
.env.*
!.env.example
.winrm/

# backups de BD (volcados pesados): no versionar, salvo el respaldo canónico
# del ecommerce (db/backups/ecommerce), que sí se versiona troceado para
# restaurar en un clon nuevo con `node dev.js --migrate`.
# OJO: algunos ya estan commiteados; para dejar de seguirlos:
#   git rm -r --cached db/backups
db/backups/*
!db/backups/ecommerce/
!db/backups/ecommerce/**
*.backup

# Archivos físicos crudos de Postgres (heap/_fsm/_vm, no portables a mano).
# Se extraen con las instrucciones de db/pg-raw/README.md; solo se versiona la
# documentación, no los binarios.
db/pg-raw/**
!db/pg-raw/README.md
!db/pg-raw/**/README.md
