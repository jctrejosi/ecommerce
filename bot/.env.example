# ─── Base de datos ────────────────────────────────────────────────
# Local (Docker):  postgresql://postgres:postgres@localhost:5432/ecommerce
# Producción (Supabase pooler):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
# Supabase exige TLS. true → conexión sin verificar certificado (igual que el backend Node).
DB_SSL=false

# ─── DeepSeek ─────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-tu-clave-aqui
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com

# ─── Servidor ─────────────────────────────────────────────────────
BOT_API_PORT=8000
# Orígenes permitidos para CORS (separados por coma). En Render usa
# el mismo CORS_ORIGIN del backend.
CORS_ORIGIN=http://localhost:5173,http://localhost:8443

# ─── Comportamiento ───────────────────────────────────────────────
# Máx. mensajes de historial enviados a DeepSeek
BOT_MAX_HISTORY=12
# Máx. tokens de respuesta
BOT_MAX_TOKENS=2000
