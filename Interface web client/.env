VITE_API_URL=http://localhost:3000
VITE_BOT_API_URL=http://localhost:8000

# Client ID de OAuth 2.0 (Web) de Google, del tipo
# "1234567890-abc123.apps.googleusercontent.com".
# NO es el client secret: los secretos empiezan con "GOCSPX-" y nunca deben
# ponerse aquí, porque las variables VITE_* quedan dentro del bundle público.
# El mismo valor va en el backend como GOOGLE_CLIENT_ID.
# Déjalo vacío para desactivar el login con Google.
VITE_GOOGLE_CLIENT_ID=
