# Copia este archivo a .env y ajusta los valores segun tu entorno.
#   cp .env.example .env

# URLs de los servicios en desarrollo local.
VITE_API_URL=http://localhost:3000
VITE_BOT_API_URL=http://localhost:8000

# Client ID de OAuth 2.0 (Web) de Google, del tipo
# "1234567890-abc123.apps.googleusercontent.com".
# NO es el client secret: los secretos empiezan con "GOCSPX-" y nunca deben
# ponerse aquí, porque las variables VITE_* quedan dentro del bundle público.
# El mismo valor va en el backend como GOOGLE_CLIENT_ID.
# Déjalo vacío para desactivar el login con Google.
VITE_GOOGLE_CLIENT_ID=

# --- Build de producción (equivalente al antiguo .env.production) ---
# La web resuelve el API en su PROPIO origen (window.location.origin) y el
# servidor que la sirve hace de proxy hacia el backend/bot. Así funciona en
# cualquier red/IP sin CORS ni IPs fijas. Déjalas vacías para usar el origen
# actual; o pon una URL fija si lo prefieres.
# VITE_API_URL=
# VITE_BOT_API_URL=
