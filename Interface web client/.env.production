# Build de producción: la web resuelve el API en su PROPIO origen
# (window.location.origin) y el servidor que la sirve hace de proxy hacia el
# backend/bot. Así funciona en cualquier red/IP sin CORS ni IPs fijas.
# Déjalas vacías para usar el origen actual; o pon una URL fija si lo prefieres.
VITE_API_URL=
VITE_BOT_API_URL=

# Opcional: déjalo vacío para desactivar el login con Google.
VITE_GOOGLE_CLIENT_ID=
