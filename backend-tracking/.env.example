# Base de datos (obligatoria). En local es la misma instancia que `ecommerce`,
# pero en una base separada.
TRACKING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mercaldas_tracking

# Broker (Redis Streams), ver `broker-tracking/docker-compose.yml`.
TRACKING_REDIS_URL=redis://localhost:6380/0

# Sales: se usan para hashear API keys e IPs. Nunca se guardan valores en claro.
# Generar con: openssl rand -hex 32
TRACKING_API_KEY_SALT=cambiar-en-produccion
TRACKING_IP_HASH_SALT=cambiar-en-produccion

# Ingesta
TRACKING_BIND_ADDR=0.0.0.0:8090
TRACKING_ENABLED=true
TRACKING_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173,http://192.168.0.132:4173,http://192-168-0-132.sslip.io:4173

# Límites
TRACKING_BATCH_SIZE=100
TRACKING_REQUEST_LIMIT_PER_MIN=120
TRACKING_EVENT_LIMIT_PER_MIN=2000
TRACKING_MAX_STREAM_LEN=1000000

# Worker
TRACKING_CONSUMER_GROUP=tracking-workers
# TRACKING_CONSUMER_NAME=worker-1
TRACKING_READ_BLOCK_MS=5000
TRACKING_CLAIM_MIN_IDLE_MS=60000
TRACKING_CLAIM_INTERVAL_MS=60000
TRACKING_DB_MAX_CONNECTIONS=10

# Streams
TRACKING_STREAM=tracking:events
TRACKING_DEAD_LETTER_STREAM=tracking:dead

# Logs: TRACKING_ENV=production, RUST_LOG=tracking=info,ingest=debug
TRACKING_ENV=local
