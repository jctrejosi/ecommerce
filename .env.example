# ============================================================
# MercAldas — variables de entorno (EJEMPLO)
# ============================================================
# Copia este archivo a `.env` y llena tus valores.
#
# ⚠️ En Render NO se usa este archivo: las variables se definen en el
#    dashboard del servicio (ver render.yaml). Como backend y bot corren
#    en el MISMO contenedor, ambos leen el mismo set de variables de
#    entorno de Render: un solo "env" compartido.
#
# En local:
#   - El bot lee automáticamente un `.env` de la raíz (load_dotenv busca
#     hacia arriba desde bot/app/).
#   - El backend NestJS, en local, usa backend/.env.development.local
#     (dotenvx). Las variables de abajo igual sirven como referencia.
# ============================================================

# ── Compartido (backend + bot) ─────────────────────────────
# PostgreSQL. Local: postgresql://postgres:postgres@localhost:5432/ecommerce
# Producción (Supabase): usa el POOLER
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# true con Supabase / Postgres gestionados; false en local
DB_SSL=false

# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8443

# ── Backend NestJS ──────────────────────────────────────────
NODE_ENV=development

# Puerto del backend (default 3000). En el contenedor lo fija el entrypoint;
# aquí solo importa al correr el backend localmente.
PORT=3000

# Secreto JWT (OBLIGATORIO: el backend no arranca sin él)
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Cloudinary (OBLIGATORIO: el backend no arranca sin credenciales)
CLOUDINARY_CLOUD_NAME=tu-cloud
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Pagos Wompi (opcional; WOMPI_API_URL se auto-detecta por la llave pública)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_REDIRECT_URL=
WOMPI_API_URL=

# Pagos ePayco (opcional; el resto tiene defaults en epayco.config.ts)
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_API_URL=https://api-secure.epayco.co
EPAYCO_CHECKOUT_URL=https://secure.payco.co/checkout.js
EPAYCO_TEST=true

# Email Resend (opcional)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=onboarding@resend.dev

# URL del frontend (para enlaces en emails)
FRONTEND_URL=http://localhost:5173

# CORS avanzado (opcional; hay defaults en cors.config.ts)
CORS_CREDENTIALS=false
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Range,X-Content-Range
CORS_MAX_AGE=86400
CORS_PREFLIGHT_CONTINUE=false
CORS_OPTIONS_SUCCESS_STATUS=204

# Helmet (opcional; hay defaults en helmet.config.ts)
HELMET_CROSS_ORIGIN_EMBEDDER_POLICY=false
HELMET_REFERRER_POLICY=

# Analizador QR externo (opcional; puerto 8000 por convención)
QR_ANALYZER_URL=http://127.0.0.1:8000

# ── Bot (Python / FastAPI) ──────────────────────────────────
DEEPSEEK_API_KEY=tu-api-key-deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=45

# Puerto interno del bot (en el contenedor lo fija el entrypoint a 8001)
BOT_API_PORT=8001

# ── Admin IA (campañas: WhatsApp / Email / SMS) ─────────────
# API key DEDICADA (distinta a la del bot). Si se omite, admin-ia usa
# DEEPSEEK_API_KEY como respaldo.
ADMIN_IA_DEEPSEEK_API_KEY=tu-api-key-admin-ia
# Puerto interno (en el contenedor lo fija el entrypoint a 8002)
ADMIN_IA_PORT=8002
# URL que usa el backend para llamar al servicio (en el contenedor: 127.0.0.1:8002)
ADMIN_IA_URL=http://127.0.0.1:8002

# Tuning del bot (opcional)
BOT_MAX_HISTORY=12
BOT_MAX_TOKENS=2000
BOT_MAX_TOOL_ROUNDS=6
