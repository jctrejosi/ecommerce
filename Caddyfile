# Reverse proxy del servicio único de MercAldas.
# Caddy escucha en $HTTP_PORT (el PORT público que inyecta Render).
# - /bot/*       → bot FastAPI (interno 127.0.0.1:8001). handle_path quita el prefijo.
# - /ia-service/* → ia-service FastAPI (interno 127.0.0.1:8002, campañas).
# - lo demás     → backend NestJS (interno 127.0.0.1:3100, incluye socket.io).

:{$HTTP_PORT} {
	encode zstd gzip

	handle_path /bot/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle_path /ia-service/* {
		reverse_proxy 127.0.0.1:8002
	}

	handle {
		reverse_proxy 127.0.0.1:3100
	}
}
