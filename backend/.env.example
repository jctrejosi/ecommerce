# Copia este archivo y rellena los valores segun tu entorno:
#   cp .env.example .env.development.local
# (los scripts `npm run dev` / `npm start` cargan .env.development.local)

# ── Aplicación ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
DB_SSL=false

# ── JWT (admin) ──────────────────────────────────────────────
# Genera uno propio, p. ej.: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ── JWT (clientes) ───────────────────────────────────────────
CUSTOMER_JWT_SECRET=cambia-este-otro-secreto
CUSTOMER_JWT_EXPIRES_IN=7d
CUSTOMER_JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8443,http://localhost:8444,http://localhost:8445,http://localhost:8446,http://localhost:8447
CORS_CREDENTIALS=true

# ── Helmet ───────────────────────────────────────────────────
HELMET_CROSS_ORIGIN_RESOURCE_POLICY=cross-origin
HELMET_CROSS_ORIGIN_OPENER_POLICY=unsafe-none
HELMET_CROSS_ORIGIN_EMBEDDER_POLICY=false

# ── Cloudinary (imágenes) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Wompi (pagos) ────────────────────────────────────────────
# Vacias a proposito: sin llaves el checkout oculta tarjeta/Nequi/PSE y deja
# efectivo y Bre-B. El backend arranca igual (solo falla al intentar cobrar).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_REDIRECT_URL=

# ── ePayco (pagos) ───────────────────────────────────────────
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_TEST=true

# ── Google OAuth (clientes) ──────────────────────────────────
# Vacío a proposito: sin client id el botón de Google no aparece; el login
# normal con correo y contraseña sigue funcionando.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Firebase (push) ──────────────────────────────────────────
# Vacío a proposito: sin la cuenta de servicio el push queda inactivo (las
# notificaciones in-app y el WebSocket siguen igual).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Scripts (seed / branches) ────────────────────────────────
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
PROD_DATABASE_URL=
ADMIN_PASSWORD=cambia-esta-clave
CUSTOMER_PASSWORD=cambia-esta-clave

# ── Servicios auxiliares ─────────────────────────────────────
# Analizador de QR externo (Vassago QR_analyzer, node dev.js --qr → :8020)
QR_ANALYZER_URL=http://127.0.0.1:8020
