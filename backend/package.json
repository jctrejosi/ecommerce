{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "dotenvx run -f .env.development.local -- nest start --watch --preserveWatchOutput",
    "build:prod": "node ./node_modules/@nestjs/cli/bin/nest.js build && yarn build:scripts",
    "build:scripts": "tsc --outDir dist --rootDir . --module nodenext --target ES2023 --moduleResolution nodenext --esModuleInterop --skipLibCheck --declaration false --sourceMap false scripts/seed.ts scripts/import-products-from-json.ts scripts/upload-product-images.ts scripts/repair-encoding.ts 2>&1",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "dotenvx run -f .env.development.local -- nest start",
    "start:debug": "dotenvx run -f .env.development.local -- nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "migrate:prod": "node scripts/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:run": "node dist/scripts/seed.js",
    "import:run": "node dist/scripts/import-products-from-json.js",
    "images:run": "node dist/scripts/upload-product-images.js",
    "deploy": "yes | npx drizzle-kit push && yarn seed:run && yarn import:run && yarn start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run --project unit && vitest run --project e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage"
  },
